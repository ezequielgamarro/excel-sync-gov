  "panels": [
    {
      "id": 1,
      "title": "Ingesta: eventos/s (por resultado)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (result) (rate(ingest_events_total[1m]))", "legendFormat": "{{result}}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Latencia p95 (todas las rutas)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Conexiones WSS activas",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (room_id) (wss_connections)", "legendFormat": "{{room_id}}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Tasa de rechazo/error (4xx-5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_responses_4xx_5xx_total[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Synthetic checks (probe_success)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "probe_success{job=\"synthetic-health\"}", "legendFormat": "{{instance}}", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "title": "Salud de réplicas (up)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(up{job=\"backend\"})", "legendFormat": "réplicas", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "title": "Payload máximo de ingesta (bytes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "ingest_max_payload_bytes", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "title": "Debounce SQL y alertas activas",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
