# Configuración NO secreta del dashboard (SPA) — 100% Supabase.
# Solo se necesitan las credenciales públicas del proyecto Supabase (URL + anon
# key). No hay backend propio ni secretos en el bundle.

# URL del proyecto Supabase (https://<ref>.supabase.co). Sin barra final.
VITE_SUPABASE_URL=https://your-project.supabase.co

# Clave pública `anon` de Supabase (segura para el navegador con RLS activo).
VITE_SUPABASE_ANON_KEY=your-anon-key
