# Configuración NO secreta del dashboard (SPA) — T47/T49.
# Solo el origen público de la API. La autenticación es nativa (usuario+contraseña
# contra /auth/login); no hay issuer OIDC ni secretos en el bundle (§2.2.5).

# Origen público de la API FastAPI (REST + WSS). Sin barra final.
VITE_API_BASE_URL=https://api.example.gov/api/v1

# Base del WebSocket seguro (WSS). Por defecto se deriva de VITE_API_BASE_URL.
VITE_WS_URL=

# Sala (una instancia = una sala; OD-06). Para trazabilidad y filtrado de WSS.
VITE_ROOM_ID=sala-central

# Ruta base de la SPA en el edge (Cloudflare Pages usa "/").
VITE_BASE_PATH=/
