# =============================================================================
# .env.example — Plantilla de secretos del sistema "Google Sheets-to-Web" (Zero Trust)
# =============================================================================
# Este fichero lista ÚNICAMENTE los NOMBRES de los secretos del sistema, con su
# propósito, custodia y rotación. Es la fuente de verdad del inventario de
# secretos (spec §9.5, RNF-13).
#
# REGLA DE ORO (RNF-13, §9.4):
#   NINGÚN secreto se versiona, se embebe en el código del origen (Apps Script),
#   se incluye en el bundle del navegador, se escribe en logs ni se devuelve en
#   respuestas HTTP. Los valores reales viven en un GESTOR DE SECRETOS (y, en el
#   origen Google Sheets, en las `Script Properties` del script). Este fichero es
#   SOLO la plantilla de nombres; NUNCA se rellena con valores reales.
#
# Componentes: backend (FastAPI), apps-script (origen Google Sheets),
#   PostgreSQL, Redis. El dashboard (SPA) NO tiene secretos: solo consume el
#   origen público de la API (config no secreta, ver §2.2.5). La autenticación es
#   nativa (usuario+contraseña → JWT), sin IdP externo.
#
# Copiar a `.env` solo en desarrollo local (`.env` está ignorado por git);
# en producción los valores se inyectan desde el gestor de secretos.
# =============================================================================

# =============================================================================
# 1. BASE DE DATOS (PostgreSQL) — rol de servicio `svc_dashboard`
# -----------------------------------------------------------------------------
# Identidad de servicio de MÍNIMO privilegio: SELECT sobre vistas/agregados,
# INSERT+SELECT sobre audit_event; sin DDL, sin DELETE, sin UPDATE (§2.2.4).
# Custodia: gestor de secretos → variable de entorno en runtime.
# Rotación: 90 días (credenciales del almacén, §9.3/§9.5).
# Conexión con TLS + SCRAM-SHA-256 y `sslmode=verify-full` (RNF-01.g).
# =============================================================================

# URL completa de conexión (alternativa recomendada; contiene la contraseña).
# Formato: postgresql+asyncpg://svc_dashboard:<contraseña>@<host>:5432/<db>?sslmode=verify-full
# NUNCA registrarla en logs (contiene credenciales).
DATABASE_URL=

# Usuario del rol de servicio (normalmente `svc_dashboard`). No es secreto en
# sí, pero se lista para componer la conexión por piezas si no se usa DATABASE_URL.
SVC_DASHBOARD_DB_USER=

# Contraseña del rol `svc_dashboard` (solo si se compone la conexión por piezas
# en lugar de usar DATABASE_URL). Secreto; rotación 90 días.
SVC_DASHBOARD_DB_PASSWORD=

# =============================================================================
# 2. REDIS — pub/sub, presencia y rate limiting distribuido
# -----------------------------------------------------------------------------
# Custodia: gestor de secretos → variable de entorno del backend.
# Rotación: 90 días (credenciales de Redis, §9.5). Redis es descartable (RNF-14).
# =============================================================================

# URL de conexión (TLS + AUTH). Formato: rediss://<usuario>:<contraseña>@<host>:<puerto>/<db>
REDIS_URL=

# Contraseña AUTH de Redis (solo si no va embebida en REDIS_URL).
REDIS_PASSWORD=

# =============================================================================
# 3. AUTH NATIVA JWT (usuario+contraseña; SIN IdP externo NI SSO)
# -----------------------------------------------------------------------------
# El backend emite y verifica sus propios JWT. La clave de firma es SECRETA y se
# inyecta desde el gestor de secretos; jamás se versiona ni se registra (RNF-13).
# Los usuarios locales viven en PostgreSQL (app.user_account, hash Argon2id).
# =============================================================================

# Clave de firma HS256 (32+ bytes aleatorios) o clave privada PEM si RS256.
# SECRETA. Rotación con solape de validación. Nunca en el bundle ni en logs.
JWT_SIGNING_KEY=

# Algoritmo: HS256 (clave simétrica) | RS256 (clave privada PEM).
JWT_ALGORITHM=HS256
# `iss`/`aud` del token; vida del access token en segundos (15 min = 900).
JWT_ISSUER=excel-sync-gov-backend
JWT_AUDIENCE=dashboard-api
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_CLOCK_SKEW_SECONDS=60
# Almacén del refresh rotativo: memory | redis.
JWT_REFRESH_STORE=memory

# =============================================================================
# 4. CIFRADO — clave de datos (DEK) y clave de envoltura (KEK)
# -----------------------------------------------------------------------------
# Envelope encryption (§9.1–§9.3): la DEK (AES-256) cifra/descifra las
# instantáneas; la KEK envuelve la DEK. El `KEY_ID` identifica la versión de
# clave (kid). Custodia: KEK y DEK en el gestor de secretos (backend) y en
# memoria en runtime. NUNCA en la base de datos, en logs ni en el repositorio.
# Rotación (§9.3): DEK 30 días o 2^20 mensajes; KEK 90 días (re-wrap transparente).
# =============================================================================

# Identificador/alias de la KEK en el gestor de secretos.
KEK_ID=

# Material de la KEK (clave de envoltura AES-256, base64/hex). Secreto.
# Rotación 90 días o ante compromiso.
KEK_MATERIAL=

# Clave de datos AES-256 (DEK) vigente, referenciada por KEY_ID. Secreto.
# Rotación 30 días o 2^20 mensajes con la misma key_id (§9.3).
DATA_KEY=

# Identificador de la versión de la clave de datos (`X-Key-Id` en el sobre cifrado).
# Apunta a la versión de clave vigente en el secret manager; el descifrado usa el
# `kid` del sobre (§9.2/§9.3).
KEY_ID=

# =============================================================================
# 5. WEBHOOK DE APPS SCRIPT (origen Google Sheets)
# -----------------------------------------------------------------------------
# El origen no custodia el secreto en código ni en disco: vive en las
# `Script Properties` del script (cifrado en reposo por Google) y el material
# del secreto se conserva en el secret manager del backend. En la base de datos
# solo se guarda metadata (`webhook_secret`: `key_id`, estado, fechas).
# Referencia: SPEC-001 §9.2, §9.3, §10.1, RNF-02.b/e.
# =============================================================================

# Identificador del webhook emitido por el platform-admin (cabecera
# `X-Webhook-Id`). No es secreto; identifica el origen/documento.
WEBHOOK_ID=

# Versión vigente del secreto (cabecera `X-Webhook-Key-Id`), alineada con la
# tabla `webhook_secret`. Rotación cada 90 días con solape de 24 h.
WEBHOOK_KEY_ID=

# Secreto compartido del webhook (HMAC-SHA256, 256 bits). SECRETO: el material
# reside en el secret manager (backend) y en `Script Properties` (Apps Script);
# NUNCA en la base de datos, en el código `.gs`, en el repo ni en logs.
WEBHOOK_SECRET=

# Versión del contrato/sobre (cabecera `X-Webhook-Version`), p. ej. 1.0.0.
WEBHOOK_VERSION=1.0.0

# Endpoint del proveedor de solo lectura usado por la reconciliación por polling
# de respaldo ante triggers perdidos (RF-01.i). Debe ser un origen allowlisted.
WEBHOOK_RECONCILE_ENDPOINT=

# =============================================================================
# 6. GESTOR DE SECRETOS / PROVEEDOR (referencias)
# -----------------------------------------------------------------------------
# Nombres de referencia para el proveedor que custodia los secretos en runtime
# (RNF-13.a). La credencial de acceso al propio gestor ES un secreto y rota.
# =============================================================================

# Proveedor: cloudflare_secrets | vault | aws_secretsmanager | gcp_secretmanager | ...
SECRET_MANAGER_PROVIDER=

# Endpoint del gestor (solo si es autohospedado, p. ej. Vault). No secreto.
SECRET_MANAGER_URL=

# Token/credencial de autenticación contra el gestor de secretos. Secreto;
# rotación periódica; jamás en repo ni logs.
SECRET_MANAGER_TOKEN=

# Prefijo/mount base donde residen los secretos del sistema (p. ej. /secret/excel-sync-gov).
SECRET_MANAGER_PATH=

# =============================================================================
# 7. BACKUPS — clave de cifrado independiente de producción
# -----------------------------------------------------------------------------
# La clave de cifrado de backups es DISTINTA de la de producción y rota por ciclo
# (RNF-14.c, §9.5). Se conserva la clave histórica necesaria para restaurar.
# =============================================================================

# Clave de cifrado de backups (independiente de producción). Secreto.
# Rotación por ciclo de backups.
BACKUP_ENCRYPTION_KEY=

# Referencia/credenciales del almacén de respaldo cifrado y geográficamente
# separado (RNF-14.e). Secreto; acceso solo del rol de servicio de respaldo.
BACKUP_STORAGE_CREDENTIALS=

# =============================================================================
# 8. OBSERVABILIDAD — endpoints internos
# -----------------------------------------------------------------------------
# `/metrics` (Prometheus) y `/health/ready` son SOLO de red interna, nunca
# públicos en el edge (RNF-07.c). Si el scraper/exportador exige autenticación,
# su token ES un secreto. Los endpoints OTLP pueden llevar API key en cabeceras.
# =============================================================================

# Endpoint interno de métricas (no público). No secreto; solo red interna.
METRICS_ENDPOINT=

# Token bearer del scraper Prometheus (opcional). Secreto si se usa; rotación
# periódica; jamás en logs.
METRICS_SCRAPE_TOKEN=

# Endpoint del exportador OTLP (trazas distribuidas, RNF-07.b). No secreto.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Cabeceras/API key del exportador OTLP (puede contener un token). Secreto si aplica.
OTEL_EXPORTER_OTLP_HEADERS=

# =============================================================================
# 9. TLS 1.3, HSTS y CORS (F2, T18 — RNF-01, OD-09, §2.2.2/§2.2.5)
# -----------------------------------------------------------------------------
# OD-09/RNF-01.a: SOLO TLS 1.3 (TLS 1.2 deshabilitado, sin ventana). El TLS se
# termina en el edge (Cloudflare/WAF) configurado "TLS 1.3 only". Si el backend
# sirve TLS directamente (`py -m app.core.tls`), su SSLContext fuerza
# minimum_version=maximum_version=TLSv1_3 (backend/app/core/tls.py).
#
# CORS: allowlist EXACTA separada por comas (deny-all si vacía).
# CORS_ALLOW_CREDENTIALS solo se aplica si la allowlist no está vacía.
# =============================================================================

# Rutas del certificado y la llave TLS 1.3 del backend (si sirve TLS directo).
# No son secretos por sí mismas; la contraseña de la llave SÍ es secreta.
TLS_CERTFILE=
TLS_KEYFILE=
TLS_KEYFILE_PASSWORD=
TLS_CA_CERTS=

# Escucha del servidor TLS embebido (`py -m app.core.tls`).
HOST=0.0.0.0
PORT=8000

# Fuerza la redirección http→https (301) cuando el backend está detrás del edge.
FORCE_TLS=false

# HSTS: max-age=31536000; includeSubDomains; preload (RNF-01.b).
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Allowlist exacta de orígenes CORS (p. ej. https://dashboard.<dominio-gob>).
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# 10. RECONCILIACIÓN POR POLLING DE RESPALDO Y SALUD DEL ORIGEN (F6, T45/T46)
# -----------------------------------------------------------------------------
# Red de seguridad ante triggers perdidos (RF-01.i, RNF-06.f): un job programado
# lee el documento con la API de Google Sheets usando una service account de
# SOLO LECTURA y compara `content_sha256` con `snapshot_current`. La credencial
# ES un secreto: jamás se versiona ni se registra (RNF-13.a, §9.5).
# =============================================================================

# Habilita el supervisor (reconciliación + monitor de salud). Requiere la
# service account configurada; si falta, solo se ejecuta la reconciliación nula.
RECONCILIATION_ENABLED=false

# Cadencia del job de reconciliación (segundos; por defecto 60 s, RF-01.a).
RECONCILIATION_INTERVAL_SECONDS=60

# Umbral de modo degradado del origen (segundos; 15 min = 900, RF-01.j).
SOURCE_DEGRADED_THRESHOLD_SECONDS=900

# Cadencia del monitor de salud del origen (segundos).
SOURCE_HEALTH_MONITOR_SECONDS=60

# JSON completo (o ruta) de la service account de SOLO LECTURA de Google Sheets.
# SECRETO: gestor de secretos → entorno. NUNCA en el repo ni en logs.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Base de la API de Google Sheets (no secreta; se puede ajustar por entorno).
GOOGLE_SHEETS_API_BASE=https://sheets.googleapis.com/v4

# Sufijo de rango A1 opcional (p. ej. "!A1:Z1000"); vacío = hoja completa.
GOOGLE_SHEETS_RANGE_SUFFIX=
