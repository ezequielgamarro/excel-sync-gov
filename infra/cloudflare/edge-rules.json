{
  "description": "Política de borde documentada para el proxy de origen (T73). Fuente de verdad ejecutable: infra/terraform/cloudflare.tf. Este JSON es el contrato legible de reglas (WAF gestionado, rate limit por IP del webhook y TLS 1.3).",
  "tls": {
    "min_tls_version": "1.3",
    "tls_13": "on",
    "tls_12": "off",
    "ssl_mode": "strict",
    "always_use_https": "on",
    "automatic_https_rewrites": "on",
    "opportunistic_encryption": "on",
    "hsts": {
      "enabled": true,
      "max_age": 31536000,
      "include_subdomains": true,
      "preload": true,
      "nosniff": true
    }
  },
  "waf": {
    "managed_rulesets": [
      {
        "name": "Cloudflare Managed Ruleset",
        "action": "execute",
        "sensitivity": "high"
      },
      {
        "name": "Cloudflare OWASP Core Ruleset",
        "action": "execute",
        "paranoia_level": "PL2"
      }
    ],
    "custom_rules": [
      {
        "description": "Solo HTTPS/HTTP declarados y sin métodos peligrosos hacia la ingesta",
        "expression": "(http.request.uri.path eq \"/ingest/webhook\" and not http.request.method in {\"POST\"})",
        "action": "block"
      },
      {
        "description": "La ingesta solo admite el User-Agent declarado por Apps Script",
        "expression": "(http.request.uri.path eq \"/ingest/webhook\" and http.user_agent ne \"GoogleAppsScript\")",
        "action": "managed_challenge"
      }
    ]
  },
  "rate_limits": [
    {
      "description": "Rate limit de borde por IP para /ingest/webhook (defensa en profundidad, RNF-12.e)",
      "expression": "(http.request.uri.path eq \"/ingest/webhook\")",
      "characteristics": ["ip.src", "cf.colo.id"],
      "period_seconds": 60,
      "requests_per_period": 120,
      "mitigation_timeout_seconds": 60,
      "action": "block"
    },
    {
      "description": "Rate limit estricto de borde para /auth/* (login/refresh), por IP",
      "expression": "(starts_with(http.request.uri.path, \"/auth/\"))",
      "characteristics": ["ip.src"],
      "period_seconds": 60,
      "requests_per_period": 60,
      "mitigation_timeout_seconds": 120,
      "action": "block"
    }
  ],
  "cache": {
    "assets": {
      "match": "/assets/*",
      "cache_control": "public, max-age=31536000, immutable"
    },
    "app_shell": {
      "match": ["/index.html", "/sw.js", "/manifest.webmanifest"],
      "cache_control": "no-cache"
    },
    "api_and_wss": {
      "match": ["/api/*", "/ws/*", "/ingest/*", "/auth/*"],
      "cache_control": "no-store"
    }
  }
}
