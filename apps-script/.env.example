# =============================================================================
# apps-script/.env.example — Configuración y secretos del origen Google Sheets
# =============================================================================
# El origen NO usa variables de entorno ni un fichero `.env`: Apps Script lee su
# configuración de **`Script Properties`** (`PropertiesService.getScriptProperties()`),
# que se configuran en el editor (Proyecto → Configuración del script →
# Propiedades del script) y quedan **cifradas en reposo** por Google.
#
# Este fichero documenta ÚNICAMENTE los NOMBRES de las propiedades y su forma.
# NO se rellena con valores reales y NUNCA se versiona ningún secreto.
#
# Referencia normativa: SPEC-001 §9 (gestión de claves y secretos), RNF-02.b/e,
# RNF-13 y §10.1 (contrato de `POST /api/v1/ingest/webhook`).
# =============================================================================

# --- Script Properties (configuración del origen) ----------------------------
# Nombre de la hoja/ID del documento declarado (solo lectura). No es secreto.
WEBHOOK_DOC_ID=

# URL del endpoint de ingesta del backend. Debe ser el origen allowlisted.
# Formato: https://api.<dominio-gob>/api/v1/ingest/webhook
WEBHOOK_ENDPOINT=

# Identificador del webhook emitido por el platform-admin (cabecera
# `X-Webhook-Id`). No es secreto, pero identifica el origen.
WEBHOOK_ID=

# Versión vigente del secreto (cabecera `X-Webhook-Key-Id`). Rota con solape 24 h.
WEBHOOK_KEY_ID=

# Secreto compartido del webhook (HMAC-SHA256, 256 bits). **SECRETO**:
# residir ÚNICAMENTE en `Script Properties`; nunca en el código `.gs`, en
# `appsscript.json`, en el repositorio ni en logs. El backend conserva el
# material en el secret manager y en la BD solo metadata (`webhook_secret`).
WEBHOOK_SECRET=

# Versión del contrato/sobre (cabecera `X-Webhook-Version`), p. ej. 1.0.0.
WEBHOOK_VERSION=1.0.0

# --- Parámetros operativos (no secretos) --------------------------------------
# Coalescencia de ráfagas de edición antes de transmitir (RF-01.b).
COALESCE_MS=750

# Reconciliación por polling de respaldo (red de seguridad ante triggers
# perdidos), en segundos (RF-01.a/f, RF-01.i).
FALLBACK_POLL_SECONDS=60

# Reintentos con backoff exponencial (RF-01.i): base 2 s, tope 60 s, jitter ±20 %.
BACKOFF_BASE_MS=2000
BACKOFF_MAX_MS=60000
BACKOFF_JITTER_PCT=20

# Umbral de degradación del origen sin contacto (RF-01.j), en minutos.
DEGRADED_AFTER_MINUTES=15

# --- Propiedades REQUERIDAS por la implementación (T38–T46) -------------------
# Allowlist de hosts del endpoint (P7/§3.4). Lista separada por comas; si está
# vacía, el envío FALLA CERRADO. Ej: api.<dominio-gob>
ALLOWED_ENDPOINT_HOSTS=

# --- Propiedades gestionadas AUTOMÁTICAMENTE por el script --------------------
# configureWebhookCredentials(...) escribe WEBHOOK_ID/DOC_ID/KEY_ID/SECRET/
# ENDPOINT/ALLOWED_ENDPOINT_HOSTS/VERSION y, al rotar, promueve la versión
# anterior a:
#   WEBHOOK_KEY_ID_PREVIOUS / WEBHOOK_SECRET_PREVIOUS (solape 24 h, §9.3)
#   WEBHOOK_OVERLAP_UNTIL (ISO-8601 UTC)
# El canal persiste su estado (dedup, salud) en:
#   LAST_SUCCESS_HASH, LAST_SUCCESS_AT, LAST_SENT_EVENT_ID, PENDING_SEND,
#   RETRIES_EXHAUSTED, WEBHOOK_BLOCKED, LAST_ERROR, LAST_LOCAL_RECEIVED_AT
# Ninguna de estas propiedades contiene material secreto salvo WEBHOOK_SECRET y
# WEBHOOK_SECRET_PREVIOUS, que NUNCA se registran ni versionan.

# --- Constantes operativas (código, no propiedades) ---------------------------
# Los valores efectivos de coalescencia/backoff/catálogos viven en
# `apps-script/00_config.gs` (COALESCE_MS, BACKOFF_SECONDS, JITTER_RATIO,
# SHEETS/HEADERS, KPIS/UNITS/TURNOS). Los parámetros de arriba documentan los
# valores por defecto del diseño (RF-01.a/b/i/j).
